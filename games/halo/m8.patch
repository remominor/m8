+
+	return unit && !TEST_FLAG(unit->object.damage_flags, _object_dead_bit);
+}
+
+/* the player's living enemies near Kevin, nearest first, and whether he can
+see each */
+static void companion_look_around(
+	long unit_index,
+	long player_unit_index)
+{
+	struct unit_datum *player_unit = unit_get(player_unit_index);
+	struct object_iterator iterator;
+	struct unit_datum *unit;
+	real_point3d eye;
+	real_point3d origin;
+
+	unit_get_camera_position(unit_index, &eye);
+	object_get_origin(unit_index, &origin);
+	companion_enemy_count = 0;
+	object_iterator_new(&iterator, _object_mask_unit, 0);
+	while ((unit = (struct unit_datum *)object_iterator_next(&iterator)) != NULL)
+	{
+		struct companion_enemy enemy;
+		real_point3d enemy_origin;
+		short index;
+
+		/* (a crew is its enemy vehicle: a banshee, not its pilot as well) */
+		if (TEST_FLAG(unit->object.damage_flags, _object_dead_bit) ||
+			!companion_enemy_team(player_unit->object.owner_team_index, unit->object.owner_team_index) ||
+			(unit->object.parent_object_index != NONE &&
+				companion_enemy_team(player_unit->object.owner_team_index,
+					object_get(unit->object.parent_object_index)->object.owner_team_index)))
+		{
+			continue;
+		}
+		object_get_origin(iterator.index, &enemy_origin);
+		enemy.distance = distance3d(&origin, &enemy_origin);
+		if (enemy.distance > COMPANION_ENEMY_DISTANCE)
+			continue;
+
+		enemy.unit_index = iterator.index;
+		enemy.aim_point = unit->object.bounding_sphere_center;
+		enemy.visible = companion_can_see(&eye, iterator.index, unit_index);
+
+		/* (kept nearest first; the farthest dropped when full) */
+		for (index = companion_enemy_count; index > 0 && (companion_enemies[index - 1].distance > enemy.distance ||
+			(companion_enemies[index - 1].distance == enemy.distance &&
+			(unsigned long)companion_enemies[index - 1].unit_index > (unsigned long)enemy.unit_index)); index--)
+		{
+			if (index < COMPANION_MAXIMUM_ENEMIES)
+				companion_enemies[index] = companion_enemies[index - 1];
+		}
+		if (index < COMPANION_MAXIMUM_ENEMIES)
+		{
+			companion_enemies[index] = enemy;
+			if (companion_enemy_count < COMPANION_MAXIMUM_ENEMIES)
+				companion_enemy_count++;
+		}
+	}
+}
+
+/* the things of a kind near him, nearest first: weapons lying on the ground,
+or vehicles he isn't in */
+static short companion_look_for(
+	long unit_index,
+	unsigned long mask,
+	real range,
+	struct companion_thing *things)
+{
+	struct object_iterator iterator;
+	struct object_datum *object;
+	real_point3d origin;
+	short count = 0;
+
+	object_get_origin(unit_index, &origin);
+	object_iterator_new(&iterator, mask, 0);
+	while ((object = object_iterator_next(&iterator)) != NULL)
+	{
+		struct companion_thing thing;
+		short index;
+
+		if (object->object.parent_object_index != NONE ||
+			iterator.index == unit_get(unit_index)->object.parent_object_index ||
+			TEST_FLAG(object->object.damage_flags, _object_dead_bit))
+		{
+			continue;
+		}
+		thing.object_index = iterator.index;
+		thing.distance = distance3d(&origin, &object->object.bounding_sphere_center);
+		if (thing.distance > range)
+			continue;
+		for (index = count; index > 0 && things[index - 1].distance > thing.distance; index--)
+		{
+			if (index < COMPANION_MAXIMUM_THINGS)
+				things[index] = things[index - 1];
+		}
+		if (index < COMPANION_MAXIMUM_THINGS)
+		{
+			things[index] = thing;
+			if (count < COMPANION_MAXIMUM_THINGS)
+				count++;
+		}
+	}
+	return count;
+}
+
+static struct companion_enemy *companion_enemy_get(
+	long unit_index)
+{
+	short index;
+
+	for (index = 0; index < companion_enemy_count; index++)
+	{
+		if (companion_enemies[index].unit_index == unit_index)
+			return &companion_enemies[index];
+	}
+	return NULL;
+}
+
+/* Read-only access: selection happens once per tick in companion_update_target. */
+static struct companion_enemy *companion_current_target(void)
+{
+	return companion_body.hold_fire ? NULL : companion_enemy_get(companion_body.target_unit_index);
+}
+
+
+/* Weapon profiles are intentionally small. Unknown ordinary weapons stay
+close; explosive/charged area weapons are not autonomous sprint-one attacks. */
+static real companion_weapon_range(char const *name)
+{
+	if (strstr(name, "rocket") || strstr(name, "fuel rod") || strstr(name, "fuel_rod") ||
+		strstr(name, "flame") || strstr(name, "plasma_cannon") || strstr(name, "plasma cannon")) return 0.f;
+	if (strstr(name, "shotgun")) return 4.f;
+	if (strstr(name, "sniper")) return 25.f;
+	if (strstr(name, "assault") || strstr(name, "plasma rifle") || strstr(name, "plasma_rifle")) return 12.f;
+	if (strstr(name, "pistol")) return 10.f;
+	if (strstr(name, "needler")) return 8.f;
+	return 4.f;
+}
+
+static real companion_engagement_range(long unit_index)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+	long weapon = unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index);
+
+	return weapon == NONE ? 0.f : companion_weapon_range(tag_name_strip_path(tag_get_name(weapon_get(weapon)->definition_index)));
+}
+
+/* Test the cone along BOTH the intended target line and actual current aim.
+Sight blockers alone omit bipeds, including Chief. */
+static boolean companion_friendly_cone(real_point3d const *eye, real_vector3d const *along,
+	real distance, real_point3d const *centre, real radius, real spread)
+{
+	real_vector3d relative;
+	real projection;
+	real squared;
+
+	vector_from_points3d(eye, centre, &relative);
+	projection = dot_product3d(&relative, along);
+	if (projection < -radius || projection > distance + radius)
+		return FALSE;
+	squared = dot_product3d(&relative, &relative) - projection * projection;
+	radius += 0.1f + MAX(0.f, projection) * spread;
+	return squared < radius * radius;
+}
+
+static boolean companion_safe_shot(long unit_index, struct companion_enemy const *enemy, boolean actual_aim)
+{
+	struct object_iterator iterator;
+	struct unit_datum *other;
+	real_point3d eye;
+	real_vector3d along;
+	struct collision_result collision;
+	real spread = 0.04f;
+	long weapon;
+	struct unit_datum *unit = unit_get(unit_index);
+
+	if (!enemy || !enemy->visible || !companion_unit_alive(enemy->unit_index) ||
+		!companion_enemy_team(unit->object.owner_team_index, unit_get(enemy->unit_index)->object.owner_team_index))
+		return FALSE;
+	unit_get_camera_position(unit_index, &eye);
+	if (collision_test_line(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit) |
+		FLAG(_collision_test_objects_bit) | _collision_test_objects_all_types_flags,
+		&eye, &enemy->aim_point, unit_index, &collision) &&
+		(collision.type != _collision_result_object || collision.object_index != enemy->unit_index))
+		return FALSE;
+	vector_from_points3d(&eye, &enemy->aim_point, &along);
+	normalize3d(&along);
+	if (actual_aim) along = companion_body.aim;
+	weapon = unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index);
+	if (weapon != NONE)
+	{
+		struct weapon_definition *definition = weapon_definition_get(weapon_get(weapon)->definition_index);
+		if (definition->weapon.triggers.count > 0)
+		{
+			struct weapon_trigger_definition *trigger = TAG_BLOCK_GET_ELEMENT(&definition->weapon.triggers, 0,
+				struct weapon_trigger_definition);
+			spread = MAX(spread, (real)tan(MIN(trigger->projectile_error_angle_upper_bound +
+				trigger->projectile_distribution_angle, 1.f)));
+		}
+	}
+	object_iterator_new(&iterator, _object_mask_unit, 0);
+	while ((other = (struct unit_datum *)object_iterator_next(&iterator)) != NULL)
+	{
+		if (iterator.index == unit_index || iterator.index == enemy->unit_index ||
+			TEST_FLAG(other->object.damage_flags, _object_dead_bit) ||
+			companion_enemy_team(unit->object.owner_team_index, other->object.owner_team_index))
+			continue;
+		if (companion_friendly_cone(&eye, &along, enemy->distance,
+			&other->object.bounding_sphere_center, other->object.bounding_sphere_radius, spread))
+			return FALSE;
+	}
+	return TRUE;
+}
+
+static boolean companion_target_eligible(struct companion_enemy const *enemy, real range)
+{
+	return enemy && enemy->visible && enemy->distance <= range &&
+		companion_safe_shot(companion_unit_index, enemy, FALSE);
+}
+
+static void companion_update_target(long unit_index)
+{
+	struct companion_enemy *current = companion_current_target();
+	struct companion_enemy *chosen = NULL;
+	real range = companion_engagement_range(unit_index);
+	long old = companion_body.target_unit_index;
+	long now = game_time_get();
+	short index;
+	char const *reason = "no valid target";
+
+	if (!companion_body.hold_fire)
+	{
+		if (companion_target_eligible(current, range))
+			chosen = current;
+		else
+		{
+			for (index = 0; index < companion_enemy_count; index++)
+				if (companion_target_eligible(&companion_enemies[index], range))
+				{
+					chosen = &companion_enemies[index];
+					break;
+				}
+			if (current && !current->visible && current->distance <= range && !chosen)
+			{
+				if (!companion_body.target_lost_time) companion_body.target_lost_time = now;
+				if (now - companion_body.target_lost_time < 3 * TICKS_PER_SECOND / 4)
+					chosen = current;
+			}
+		}
+	}
+	if (chosen && chosen->visible) companion_body.target_lost_time = 0;
+	companion_body.target_unit_index = chosen ? chosen->unit_index : NONE;
+	if (old != companion_body.target_unit_index)
+	{
+		companion_body.target_time = now;
+		companion_body.burst_time = now;
+		companion_body.target_lost_time = 0;
+		reason = chosen ? old == NONE ? "enemy acquired" : "target switched" :
+			current && current->distance > range ? "out of range" : "enemy lost";
+	}
+	else if (current && companion_body.target_visible && !current->visible)
+		reason = "visibility failure";
+	else if (!config_boolean("debug.companion") || now < companion_body.combat_log_time)
+	{
+		companion_body.target_visible = chosen && chosen->visible;
+		return;
+	}
+	platform_log("Kevin combat: %s old=%08lx target=%08lx distance=%.1f m visible=%d",
+		reason, old, companion_body.target_unit_index, chosen ? chosen->distance * COMPANION_METRES_PER_UNIT : 0.f,
+		chosen && chosen->visible);
+	companion_body.combat_log_time = now + TICKS_PER_SECOND;
+	companion_body.target_visible = chosen && chosen->visible;
+}
+
+static boolean companion_trigger_on(long elapsed, boolean latched, real rate)
+{
+	long period = MAX(2, (long)(TICKS_PER_SECOND / MAX(rate, 1.f)));
+
+	if (latched) return elapsed % period == 0;
+	return elapsed % (COMPANION_BURST_ON_TICKS + COMPANION_BURST_OFF_TICKS) < COMPANION_BURST_ON_TICKS;
+}
+
+/* ---------- moving */
+
+/* the pathfinding surface under a point, walking the ground there in a straight
+line from a biped's own; NONE if the walk stops short of it (a rock, a wall, a
+ledge in the way), not the surface where it stopped */
+static long companion_surface_from(
+	long biped_index,
+	real_point3d const *point)
+{
+	real_point3d start;
+	long start_surface_index = (companion_body.metrics.bsp++, biped_find_pathfinding_surface_index(biped_index, &start));
+	real_point2d known;
+	real_point2d target;
+	long surface_index;
+
+	if (start_surface_index == NONE)
+		return NONE;
+	known.x = start.x;
+	known.y = start.y;
+	target.x = point->x;
+	target.y = point->y;
+	companion_body.metrics.bsp++;
+	surface_index = structure_surface_index_from_point(global_structure_bsp_get(), FALSE, &known,
+		start_surface_index, &target);
+	if ((target.x - point->x) * (target.x - point->x) + (target.y - point->y) * (target.y - point->y) > 0.3f * 0.3f)
+		return NONE;
+	return surface_index;
+}
+
+/* the pathfinding surface of a spot he goes to: walked to from the Chief's
+(his goals are mostly near the Chief: beside him, his own spot near him), else
+from his own; the way there is the path search's, around what's between */
+static long companion_goal_surface(
+	long unit_index,
+	real_point3d const *point)
+{
+	long player_unit_index = companion_player_unit();
+	long surface_index = companion_unit_alive(player_unit_index) ? companion_surface_from(player_unit_index, point) : NONE;
+
+	return surface_index != NONE ? surface_index : companion_surface_from(unit_index, point);
+}
+
+static real companion_navigation_radius(long unit_index)
+{
+	struct biped_definition *definition = biped_definition_get(unit_get(unit_index)->definition_index);
+
+	return MAX(0.1f, definition->biped.collision_radius + 0.03f);
+}
+
+static void companion_find_path(
+	long unit_index,
+	long goal_surface_index)
+{
+	struct path_input input;
+	real_point3d start;
+	long start_surface_index = (companion_body.metrics.bsp++, biped_find_pathfinding_surface_index(unit_index, &start));
+
+	companion_body.path_valid = FALSE;
+	companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+	companion_body.path_time = game_time_get();
+	companion_body.next_path_time = game_time_get() + COMPANION_PATH_TICKS;
+	if (start_surface_index == NONE || goal_surface_index == NONE)
+	{
+		companion_body.nav_state = _companion_nav_invalid_surface;
+		return;
+	}
+	path_input_new(&input, companion_navigation_radius(unit_index), FALSE, unit_index);
+	path_input_set_start(&input, &start, start_surface_index);
+	csmemset(&companion_path_debug, 0, sizeof(companion_path_debug));
+	path_state_new(&input, &companion_path_state, &companion_path_debug);
+	path_state_destination(&companion_path_state, &companion_body.goal, goal_surface_index, 0.1f);
+	if (!(companion_body.metrics.paths++, path_state_find(&companion_path_state)))
+	{
+		companion_body.nav_state = companion_path_debug.path_traverse_result == _path_traverse_result_initial_not_pathfindable ?
+			_companion_nav_invalid_surface : _companion_nav_unreachable;
+		return;
+	}
+	path_obstacle_search_reach = COMPANION_OBSTACLE_REACH;
+	companion_body.path_valid = path_state_build_path(&companion_path_state, &companion_body.path);
+	path_obstacle_search_reach = 0.f;
+	if (companion_body.path_valid && (companion_body.path.step_count <= 0 ||
+		companion_body.path.step_count > MAXIMUM_SMOOTHED_PATH_STEPS))
+		companion_body.path_valid = FALSE;
+	companion_body.nav_state = companion_body.path_valid ? _companion_nav_valid :
+		companion_path_debug.path_build_result == _path_build_result_obstacle_avoidance_failed ?
+		_companion_nav_blocked : _companion_nav_unreachable;
+}
+
+
+/* a spot near him the enemy can't see, standing: the nearest of rings
+around him, with ground under it and the way there open */
+static boolean companion_find_cover(
+	long unit_index,
+	real_point3d const *threat,
+	real_point3d *cover)
+{
+	real_point3d origin;
+	real radius;
+
+	object_get_origin(unit_index, &origin);
+	for (radius = 2.5f; radius <= COMPANION_COVER_SEARCH; radius += 2.5f)
+	{
+		short place;
+
+		for (place = 0; place < 12; place++)
+		{
+			real angle = (real)place * (_pi * 2.f / 12.f);
+			real_point3d spot = origin;
+			real_point3d chest;
+			real_vector3d down = { 0.f, 0.f, -3.f };
+			struct collision_result collision;
+
+			spot.x += (real)cos(angle) * radius;
+			spot.y += (real)sin(angle) * radius;
+			spot.z += 1.f;
+			if (!companion_line_clear(&origin, &spot, unit_index) ||
+				!collision_test_vector(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit),
+					&spot, &down, NONE, &collision))
+			{
+				continue;
+			}
+			chest = collision.point;
+			chest.z += 1.2f;
+			if (!companion_line_clear(threat, &chest, unit_index))
+			{
+				*cover = collision.point;
+				return TRUE;
+			}
+		}
+	}
+	return FALSE;
+}
+
+static real companion_random01(
+	void)
+{
+	return (companion_random() + 1.f) * 0.5f;
+}
+
+/* how far apart two points are on the ground (heights differ on slopes) */
+static real companion_flat_distance(
+	real_point3d const *a,
+	real_point3d const *b)
+{
+	real dx = a->x - b->x;
+	real dy = a->y - b->y;
+
+	return (real)sqrt(dx * dx + dy * dy);
+}
+
+/* the player's view: its camera as main.c makes the player's window's
+(set_window_camera_values: smooth motion, the camera's shake, display.fov)
+and its projection, on the screen as drawn (render.camera's bounds, the
+whole screen's, as the player's window's are with one player); FALSE
+without a player */
+static boolean companion_view_camera(
+	struct render_camera *camera,
+	struct render_frustum *frustum)
+{
+	struct render_window window;
+	short local_player_index = local_player_get_next(NONE);
+	struct observer_result const *observer;
+
+	if (local_player_index == NONE)
+		return FALSE;
+	observer = render_interpolation_camera(local_player_index, observer_get_camera(local_player_index));
+	if (!observer)
+		return FALSE;
+	memset(&window, 0, sizeof(window));
+	window.local_player_index = local_player_index;
+	window.rasterizer_camera.viewport_bounds = render.camera.viewport_bounds;
+	window.rasterizer_camera.window_bounds = render.camera.window_bounds;
+	set_window_camera_values(&window, observer);
+	*camera = window.rasterizer_camera;
+	render_camera_build_frustum(camera, NULL, frustum, TRUE);
+	return TRUE;
+}
+
+/* the way into a vehicle: the entrance of the nearest seat he can take now
+(the game's own, unit_get_seat_entrance_point); FALSE if none is free */
+static boolean companion_seat_entrance(
+	long unit_index,
+	long vehicle_index,
+	real_point3d *entrance)
+{
+	struct unit_definition *definition = unit_definition_get(unit_get(vehicle_index)->definition_index);
+	real_point3d origin;
+	real best = REAL_MAX;
+	short seat_index;
+
+	object_get_origin(unit_index, &origin);
+	for (seat_index = 0; seat_index < definition->unit.seats.count; seat_index++)
+	{
+		real_point3d point;
+		real_point3d seat;
+		long occupant_index = NONE;
+
+		if (unit_get_seat_entrance_point(unit_index, vehicle_index, seat_index, &point, &seat, NULL) &&
+			unit_can_enter_seat(unit_index, vehicle_index, seat_index, &occupant_index) &&
+			distance3d(&origin, &point) < best)
+		{
+			best = distance3d(&origin, &point);
+			*entrance = point;
+		}
+	}
+	return best < REAL_MAX;
+}
+
+/* the ground at a point of the player's view (-1 to 1 across, and down, as
+its projection has it): where a line from the camera through it meets the
+level or an object, or, a wall or an object, the ground a step short of it;
+FALSE if it meets nothing within reach, or there's no ground */
+static boolean companion_view_ground(
+	struct render_camera const *camera,
+	struct render_frustum const *frustum,
+	real x,
+	real y,
+	real_point3d *ground)
+{
+	real_point2d screen;
+	real_point3d from;
+	real_vector3d along;
+	real_vector3d down = { 0.f, 0.f, -4.f };
+	real_point3d above;
+	struct collision_result collision;
+
+	screen.x = x;
+	screen.y = y;
+	render_camera_screen_to_world(camera, frustum, &screen, &from, &along);
+	normalize3d(&along);
+	scale_vector3d(&along, COMPANION_VIEW_REACH, &along);
+	if (!collision_test_vector(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit) |
+			FLAG(_collision_test_objects_bit) | _collision_test_objects_sight_blocking_flags,
+		&from, &along, companion_player_unit(), &collision))
+	{
+		return FALSE;
+	}
+	if (collision.type == _collision_result_structure && collision.plane.n.k >= 0.6f)
+	{
+		*ground = collision.point;
+		return TRUE;
+	}
+	normalize3d(&along);
+	point_from_line3d(&collision.point, &along, -0.6f, &above);
+	above.z += 0.5f;
+	if (!collision_test_vector(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit),
+			&above, &down, NONE, &collision) ||
+		collision.plane.n.k < 0.6f)
+	{
+		return FALSE;
+	}
+	*ground = collision.point;
+	return TRUE;
+}
+
+/* whether he can find a way to a point (the search is his path's: his path is
+found again after) */
+static boolean companion_reachable(
+	long unit_index,
+	real_point3d const *point)
+{
+	struct path_input input;
+	struct path_result result;
+	real_point3d start;
+	real_point3d goal = *point;
+	long start_surface_index = (companion_body.metrics.bsp++, biped_find_pathfinding_surface_index(unit_index, &start));
+	long goal_surface_index = companion_goal_surface(unit_index, &goal);
+	boolean reachable;
+
+	if (start_surface_index == NONE || goal_surface_index == NONE)
+		return FALSE;
+	path_input_new(&input, companion_navigation_radius(unit_index), FALSE, unit_index);
+	path_input_set_start(&input, &start, start_surface_index);
+	path_state_new(&input, &companion_path_state, NULL);
+	path_state_destination(&companion_path_state, &goal, goal_surface_index, 0.1f);
+	if (!(companion_body.metrics.paths++, path_state_find(&companion_path_state)))
+		return FALSE;
+	path_obstacle_search_reach = COMPANION_OBSTACLE_REACH;
+	reachable = path_state_build_path(&companion_path_state, &result);
+	path_obstacle_search_reach = 0.f;
+	return reachable;
+}
+
+/* a spot near the Chief to be in while he's still: on his side of the Chief,
+on the ground, in the Chief's sight, one he can get to with no object (a wreck,
+a vehicle) in the way, which the level's pathfinding doesn't know of; his own
+place, if none */
+static void companion_pick_idle_spot(
+	long unit_index,
+	real_point3d const *player_origin)
+{
+	real_point3d origin;
+	real side;
+	short attempt;
+
+	object_get_origin(unit_index, &origin);
+	companion_body.idle_spot = origin;
+	side = (real)atan2(origin.y - player_origin->y, origin.x - player_origin->x);
+	for (attempt = 0; attempt < 6; attempt++)
+	{
+		real angle = side + companion_random() * 1.2f;
+		real radius = COMPANION_IDLE_NEAR + companion_random01() * (COMPANION_IDLE_FAR - COMPANION_IDLE_NEAR);
+		real_point3d spot = *player_origin;
+		real_point3d from = *player_origin;
+		real_point3d from_him = origin;
+		real_point3d to;
+		struct collision_result collision;
+
+		spot.x += (real)cos(angle) * radius;
+		spot.y += (real)sin(angle) * radius;
+		from.z += 0.5f;
+		to = spot;
+		to.z += 0.5f;
+		from_him.z += 0.5f;
+		if (companion_line_clear(&from, &to, unit_index) &&
+			!collision_test_line(FLAG(_collision_test_objects_bit) | _collision_test_objects_sight_blocking_flags,
+				&from_him, &to, unit_index, &collision) &&
+			companion_reachable(unit_index, &spot))
+		{
+			companion_body.idle_spot = spot;
+			break;
+		}
+	}
+	companion_body.idle_valid = TRUE;
+	companion_body.idle_nearest = 1000.f;
+	companion_body.idle_nearer_time = game_time_get();
+	companion_body.idle_until = game_time_get() + (long)((6.f + 9.f * companion_random01()) * TICKS_PER_SECOND);
+}
+
+/* Stable following with a stop/resume band; no random idle destinations. */
+static boolean companion_follow_goal(
+	long unit_index,
+	long player_unit_index,
+	real_point3d *goal)
+{
+	real_point3d origin;
+	real_point3d player_origin;
+	real_vector3d forward = object_get(player_unit_index)->object.translational_velocity;
+	real distance;
+
+	object_get_origin(unit_index, &origin);
+	object_get_origin(player_unit_index, &player_origin);
+	distance = companion_flat_distance(&origin, &player_origin);
+	forward.k = 0.f;
+	/* Hysteresis: keep the last safe position when Chief stops nearby. */
+	if (distance < 0.65f || (distance < 1.3f && !companion_body.requested_move))
+		return FALSE;
+	if (magnitude3d(&forward) < COMPANION_MOVING_SPEED)
+		forward = object_get(player_unit_index)->object.forward;
+	forward.k = 0.f;
+	normalize3d(&forward);
+	*goal = player_origin;
+	goal->x -= forward.i * 0.8f;
+	goal->y -= forward.j * 0.8f;
+	companion_body.pace = distance > 1.3f ? 1.f : 0.65f;
+	return companion_flat_distance(&origin, goal) > 0.2f;
+}
+
+
+/* where the order takes him now (FALSE: nowhere, he stands) */
+static boolean companion_goal(
+	long unit_index,
+	long player_unit_index,
+	struct companion_enemy const *target,
+	real_point3d *goal)
+{
+	real_point3d origin;
+
+	object_get_origin(unit_index, &origin);
+	companion_body.pace = 1.f;
+	if (companion_body.order == _companion_order_hold || companion_body.order == _companion_order_move)
+	{
+		*goal = companion_body.hold_point;
+		return distance3d(&origin, goal) > 0.2f;
+	}
+	return companion_follow_goal(unit_index, player_unit_index, goal);
+}
+
+
+/* One support probe, also used for the immediate next step on cached terrain. */
+static boolean companion_ground_probe(long unit_index, real_point3d const *point,
+	real above, real below, real_point3d *ground)
+{
+	struct biped_definition *definition = biped_definition_get(unit_get(unit_index)->definition_index);
+	real_point3d from = *point;
+	real_vector3d down = { 0.f, 0.f, 0.f };
+	struct collision_result collision;
+
+	companion_body.metrics.ground++;
+	from.z += above;
+	down.k = -(above + below);
+	if (!collision_test_vector(FLAG(_collision_test_structure_bit) |
+		FLAG(_collision_test_front_facing_surfaces_bit), &from, &down, unit_index, &collision) ||
+		collision.type != _collision_result_structure || collision.surface_index == NONE ||
+		collision.plane.n.k < definition->biped.runtime_minimum_normal_k)
+		return FALSE;
+	*ground = collision.point;
+	return TRUE;
+}
+
+/* Real walkable structure at this height, including the footprint's ledge margin. */
+static boolean companion_ground(long unit_index, real_point3d const *point,
+	real above, real below, real_point3d *ground)
+{
+	struct biped_definition *definition = biped_definition_get(unit_get(unit_index)->definition_index);
+	real radius = definition->biped.collision_radius + 0.04f;
+	real cosine = MAX(definition->biped.runtime_minimum_normal_k, 0.1f);
+	real slope = (real)sqrt(MAX(0.f, 1.f - cosine * cosine)) / cosine;
+	short sample;
+
+	for (sample = 0; sample < 5; sample++)
+	{
+		real_point3d from = *point;
+		real_point3d support;
+
+		if (sample == 1) from.x += radius;
+		if (sample == 2) from.x -= radius;
+		if (sample == 3) from.y += radius;
+		if (sample == 4) from.y -= radius;
+		if (!companion_ground_probe(unit_index, &from, above, below, &support))
+			return FALSE;
+		if (!sample)
+			*ground = support;
+		else if (fabs(support.z - ground->z) > radius * slope + 0.04f)
+			return FALSE;
+	}
+	return TRUE;
+}
+
+static boolean companion_clearance(
+	long unit_index,
+	real_point3d const *from,
+	real_point3d const *to)
+{
+	real_point3d pill;
+	real height;
+	real radius;
+	real_vector3d movement;
+	real_point3d clipped;
+	real_vector3d velocity;
+	struct collision_plane collisions[16];
+	struct collision_feature_list features;
+	struct collision_plane overlap;
+	real_point3d origin;
+	real_point3d base;
+	real_point3d end;
+	real_point3d centre;
+	struct biped_definition *definition = biped_definition_get(unit_get(unit_index)->definition_index);
+
+	companion_body.metrics.clearance++;
+	biped_get_physics_pill(unit_index, &pill, &height, &radius);
+	/* Actor-less bipeds can expose a sphere to physics; still require room
+	for Kevin's entire standing body before certifying a maneuver/location. */
+	height = MAX(height, definition->biped.collision_height_standing - 2.f * radius);
+	object_get_origin(unit_index, &origin);
+	base = *from;
+	end = *to;
+	base.z += pill.z - origin.z;
+	end.z += pill.z - origin.z;
+	vector_from_points3d(&base, &end, &movement);
+	centre = base;
+	centre.x += movement.i * 0.5f;
+	centre.y += movement.j * 0.5f;
+	centre.z += height * 0.5f + movement.k * 0.5f;
+	if (collision_get_features_in_sphere(_collision_test_for_bipeds_living_flags,
+		&centre, magnitude3d(&movement) * 0.5f + height * 0.5f + radius + 0.02f,
+		height, radius + 0.02f, unit_index, &features) &&
+		(collision_features_test_point(&features, &base, &overlap) ||
+		 collision_features_test_point(&features, &end, &overlap)))
+		return FALSE;
+	collision_move_pill(_collision_test_for_bipeds_living_flags, &base, &movement,
+		height, radius + 0.02f, unit_index, &clipped, &velocity, 16, collisions);
+	return distance3d(&clipped, &end) < 0.02f;
+}
+
+static void companion_navigation_note(char const *reason)
+{
+	real_point3d origin;
+
+	if (companion_unit_index == NONE || game_time_get() < companion_body.nav_log_time)
+		return;
+	object_get_origin(companion_unit_index, &origin);
+	platform_log("Kevin nav: %s order=%s goal=(%.2f %.2f %.2f) state=%d distance=%.2f failures=%d recovery=%d traverse=%d build=%d",
+		reason, companion_order_names[companion_body.order], companion_body.goal.x,
+		companion_body.goal.y, companion_body.goal.z, companion_body.nav_state,
+		distance3d(&origin, &companion_body.goal), companion_body.failures, companion_body.recovery,
+		companion_path_debug.path_traverse_result, companion_path_debug.path_build_result);
+	companion_body.nav_log_time = game_time_get() + TICKS_PER_SECOND;
+}
+
+/* Ordinary grounded motion starts at the actual physics pill, with its
+physical radius. The larger maneuver capsule would overlap supporting floor.
+Keep the standing height check, including for actor-less spherical bipeds. */
+static boolean companion_step_clearance(long unit_index, real_point3d const *from, real_point3d const *to)
+{
+	struct biped_definition *definition = biped_definition_get(unit_get(unit_index)->definition_index);
+	real_point3d pill;
+	real_point3d end;
+	real_point3d clipped;
+	real_vector3d movement;
+	real_vector3d velocity;
+	real height;
+	real radius;
+	struct collision_plane collisions[16];
+
+	companion_body.metrics.clearance++;
+	biped_get_physics_pill(unit_index, &pill, &height, &radius);
+	height = MAX(height, definition->biped.collision_height_standing - 2.f * radius);
+	vector_from_points3d(from, to, &movement);
+	point_from_line3d(&pill, &movement, 1.f, &end);
+	collision_move_pill(_collision_test_for_bipeds_living_flags, &pill, &movement,
+		height, radius, unit_index, &clipped, &velocity, 16, collisions);
+	return distance3d(&clipped, &end) < 0.02f;
+}
+
+static void companion_safety_invalidate(void)
+{
+	companion_body.safety[0].valid = FALSE;
+	companion_body.safety[1].valid = FALSE;
+}
+
+static void companion_navigation_metrics(void)
+{
+	struct companion_nav_metrics *m = &companion_body.metrics;
+	long now = game_time_get();
+
+	if (now < m->report_time)
+		return;
+	if (config_boolean("debug.companion"))
+		platform_log("Kevin nav queries: corridor=%ld ground=%ld clearance=%ld bsp=%ld paths=%ld reuse=%ld rejected=%ld",
+			m->corridors, m->ground, m->clearance, m->bsp, m->paths, m->reuse, m->rejected);
+	m->corridors = m->ground = m->clearance = m->bsp = m->paths = m->reuse = m->rejected = 0;
+	m->report_time = now + TICKS_PER_SECOND;
+}
+
+/* Require the ENTIRE stopping line to remain in the verified strip. The
+0.015 margin fits inside the footprint's 0.04 extra support margin. Expiry
+is an additional limit, never a substitute for geometric containment. */
+static boolean companion_corridor_contains(long unit_index, struct companion_corridor const *cache,
+	real_point3d const *start, real_vector3d const *along, real reach, long surface)
+{
+	real_vector3d relative;
+	real projection;
+	real lateral;
+	real end_projection;
+	real end_lateral;
+	real station;
+	real height;
+	short sample;
+
+	if (!cache->valid || game_time_get() < cache->time || game_time_get() - cache->time >= 3 ||
+		cache->surface != surface || cache->support != biped_get(unit_index)->biped.support_surface_index ||
+		cache->path_time != companion_body.path_time ||
+		cache->step != companion_body.path.step_index || cache->order != companion_body.order ||
+		cache->recovery != companion_body.recovery ||
+		distance3d(&cache->waypoint, &companion_body.progress_waypoint) > 0.001f)
+		return FALSE;
+	vector_from_points3d(&cache->start, start, &relative);
+	projection = relative.i * cache->along.i + relative.j * cache->along.j;
+	lateral = relative.i * cache->along.j - relative.j * cache->along.i;
+	end_projection = projection + reach * dot_product3d(along, &cache->along);
+	end_lateral = lateral + reach * (along->i * cache->along.j - along->j * cache->along.i);
+	if (projection < 0.f || end_projection < projection || end_projection > cache->reach - 0.02f ||
+		fabs(lateral) > 0.015f || fabs(end_lateral) > 0.015f)
+		return FALSE;
+	station = projection / cache->spacing;
+	sample = MIN((short)station, cache->samples - 1);
+	height = cache->heights[sample] + (cache->heights[sample + 1] - cache->heights[sample]) * (station - sample);
+	return fabs(start->z - height) <= 0.04f;
+}
+
+static boolean companion_validate_corridor(long unit_index, real_point3d const *start,
+	real_vector3d const *along, real reach, real speed, long surface, struct companion_corridor *cache)
+{
+	real_point3d previous = *start;
+	short sample;
+	long current_surface = surface;
+	/* Cover three ticks of travel beyond the present stopping line, without
+	widening the original four-sample spacing or elevation tolerances. */
+	real total = reach + speed * 3.f + 0.04f;
+	short count = (short)(total / (reach / 4.f)) + 1;
+	real interval = total / count;
+
+	companion_body.metrics.corridors++;
+	cache->valid = FALSE;
+	if (count < 1 || count >= 32)
+		return FALSE;
+	cache->heights[0] = start->z;
+	for (sample = 1; sample <= count; sample++)
+	{
+		real_point3d probe = previous;
+		real_point3d ground;
+		real_point2d known;
+		real_point2d point;
+		long next_surface;
+
+		probe.x = start->x + along->i * interval * sample;
+		probe.y = start->y + along->j * interval * sample;
+		if (!companion_ground(unit_index, &probe, interval + 0.12f, interval + 0.12f, &ground) ||
+			fabs(ground.z - previous.z) > interval * 0.8f + 0.08f)
+			return FALSE;
+		known.x = previous.x;
+		known.y = previous.y;
+		point.x = ground.x;
+		point.y = ground.y;
+		companion_body.metrics.bsp++;
+		next_surface = structure_surface_index_from_point(global_structure_bsp_get(), FALSE,
+			&known, current_surface, &point);
+		if (next_surface == NONE || fabs(point.x - ground.x) > 0.02f || fabs(point.y - ground.y) > 0.02f)
+			return FALSE;
+		cache->heights[sample] = ground.z;
+		previous = ground;
+		current_surface = next_surface;
+	}
+	cache->start = *start;
+	cache->along = *along;
+	cache->reach = total;
+	cache->spacing = interval;
+	cache->samples = count;
+	cache->surface = surface;
+	cache->support = biped_get(unit_index)->biped.support_surface_index;
+	cache->path_time = companion_body.path_time;
+	cache->step = companion_body.path.step_index;
+	cache->order = companion_body.order;
+	cache->recovery = companion_body.recovery;
+	cache->waypoint = companion_body.progress_waypoint;
+	cache->time = game_time_get();
+	cache->valid = TRUE;
+	return TRUE;
+}
+
+static boolean companion_safe_direction_check(long unit_index, real_vector3d const *direction)
+{
+	struct biped_datum *biped = biped_get(unit_index);
+	struct game_globals_player_information *information = TAG_BLOCK_GET_ELEMENT(
+		&scenario_get_game_globals()->player_information, 0, struct game_globals_player_information);
+	real_point3d start;
+	real_point3d support;
+	real_point3d actual;
+	real speed = magnitude2d((real_vector2d const *)&biped->object.translational_velocity);
+	real acceleration = MAX(information->run_acceleration / TICKS_PER_SECOND, 0.001f);
+	real reach = MAX(0.4f, speed * speed / (2.f * acceleration) + speed * 2.f + 0.15f);
+	long surface = (companion_body.metrics.bsp++, biped_find_pathfinding_surface_index(unit_index, &start));
+	short corridor;
+
+	companion_body.safety_obstructed = FALSE;
+	/* Pathfinding can retain a projected point. Cache containment must use the
+	body's actual position, connected back to that known navigation surface. */
+	object_get_origin(unit_index, &actual);
+	if (surface != NONE && companion_flat_distance(&start, &actual) > 0.001f)
+	{
+		real_point2d known;
+		real_point2d point;
+
+		known.x = start.x;
+		known.y = start.y;
+		point.x = actual.x;
+		point.y = actual.y;
+		companion_body.metrics.bsp++;
+		surface = structure_surface_index_from_point(global_structure_bsp_get(), FALSE, &known, surface, &point);
+		if (surface == NONE || fabs(point.x - actual.x) > 0.02f || fabs(point.y - actual.y) > 0.02f)
+			return FALSE;
+	}
+	start = actual;
+	if (surface == NONE || biped->biped.support_surface_index == NONE ||
+		!companion_ground(unit_index, &start, 0.1f, 0.15f, &support))
+		return FALSE;
+	start = support;
+	for (corridor = 0; corridor < 2; corridor++)
+	{
+		real_vector3d along = corridor ? biped->object.translational_velocity : *direction;
+		real_point3d next;
+		real_point3d ground;
+		real_point2d known;
+		real_point2d point;
+		short index;
+		boolean cached = FALSE;
+		real step = MAX(speed, COMPANION_RUN_SPEED * companion_body.pace);
+
+		along.k = 0.f;
+		if (normalize3d(&along) < 0.001f)
+			continue;
+		/* Identical requested/velocity lines need no second immediate sweep. */
+		if (corridor && fabs(along.i - direction->i) < 0.00001f && fabs(along.j - direction->j) < 0.00001f)
+			continue;
+		for (index = 0; index < 2; index++)
+			if (companion_corridor_contains(unit_index, &companion_body.safety[index], &start, &along, reach, surface))
+			{
+				cached = TRUE;
+				companion_body.metrics.reuse++;
+				break;
+			}
+		if (!cached && !companion_validate_corridor(unit_index, &start, &along, reach,
+			MAX(speed, COMPANION_RUN_SPEED * companion_body.pace), surface, &companion_body.safety[corridor]))
+			return FALSE;
+		/* Probe immediate support and moving-object clearance even on cache hits. */
+		point_from_line3d(&start, &along, step, &next);
+		if (!companion_ground_probe(unit_index, &next, step + 0.12f, step + 0.12f, &ground) ||
+			fabs(ground.z - start.z) > step * 0.8f + 0.08f)
+			return FALSE;
+		known.x = start.x;
+		known.y = start.y;
+		point.x = ground.x;
+		point.y = ground.y;
+		companion_body.metrics.bsp++;
+		if (structure_surface_index_from_point(global_structure_bsp_get(), FALSE, &known, surface, &point) == NONE ||
+			fabs(point.x - ground.x) > 0.02f || fabs(point.y - ground.y) > 0.02f)
+			return FALSE;
+		if (!companion_step_clearance(unit_index, &start, &ground))
+		{
+			companion_body.safety_obstructed = TRUE;
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
+
+static boolean companion_safe_direction(long unit_index, real_vector3d const *direction)
+{
+	boolean safe = companion_safe_direction_check(unit_index, direction);
+
+	if (!safe)
+	{
+		companion_body.metrics.rejected++;
+		companion_safety_invalidate();
+	}
+	return safe;
+}
+
+static boolean companion_try_jump(long unit_index, real_vector3d const *direction)
+{
+	struct biped_datum *biped = biped_get(unit_index);
+	real_point3d start;
+	real_point3d landing;
+	real_point3d low;
+	real_point3d high;
+	real_point3d end;
+	real_point3d ground;
+	real_vector3d along = *direction;
+	struct collision_result obstacle;
+	struct biped_definition *definition = biped_definition_get(biped->definition_index);
+	real apex;
+	real flight;
+	real reach;
+	real elevation;
+	long now = game_time_get();
+	short sample;
+
+	if (now < companion_body.jump_time || companion_body.jumping ||
+		TEST_FLAG(biped->biped.flags, _biped_airborne_bit) || biped->biped.jump_recovery_timer <= 5 ||
+		biped->biped.landing == 1 || normalize3d(&along) < 0.01f)
+		return FALSE;
+	object_get_origin(unit_index, &start);
+	if (companion_body.jump_failed && distance3d(&start, &companion_body.jump_start) < 0.6f)
+		return FALSE;
+	companion_safety_invalidate();
+	companion_body.jump_time = now + 3 * TICKS_PER_SECOND;
+	low = start;
+	low.z += 0.08f;
+	point_from_line3d(&low, &along, 0.65f, &end);
+	if (!collision_test_line(_collision_test_for_bipeds_living_flags |
+		FLAG(_collision_test_front_facing_surfaces_bit), &low, &end, unit_index, &obstacle) ||
+		obstacle.plane.n.k > 0.5f)
+		return FALSE;
+	platform_log("Kevin nav: automatic jump attempt (obstacle confirmed)");
+	/* The upper corridor must clear the obstruction. Restrict this to a low,
+	short step over scenery on continuous ground, never across a hole. */
+	point_from_line3d(&start, &along, 0.75f, &landing);
+	if (!companion_ground(unit_index, &landing, 0.1f, 0.1f, &ground) ||
+		fabs(ground.z - start.z) > 0.1f || companion_surface_from(unit_index, &ground) == NONE)
+		return FALSE;
+	for (sample = 1; sample <= 3; sample++)
+	{
+		real_point3d probe;
+		real_vector3d down = { 0.f, 0.f, -0.35f };
+		struct collision_result floor;
+
+		point_from_line3d(&start, &along, 0.25f * sample, &probe);
+		probe.z += 0.3f;
+		companion_body.metrics.ground++;
+		if (!collision_test_vector(FLAG(_collision_test_structure_bit) |
+			FLAG(_collision_test_front_facing_surfaces_bit), &probe, &down, unit_index, &floor) ||
+			floor.plane.n.k < 0.6f || fabs(floor.point.z - start.z) > 0.1f)
+			return FALSE;
+	}
+	high = start;
+	high.z += 0.27f;
+	end = ground;
+	end.z += 0.27f;
+	if (!companion_clearance(unit_index, &high, &end))
+		return FALSE;
+	/* Verify a conservative envelope derived from the engine's own jump
+	impulse/gravity and ordinary running speed. This does not simulate physics. */
+	if (global_gravity <= 0.f || definition->biped.jump_velocity <= 0.f)
+		return FALSE;
+	apex = definition->biped.jump_velocity * definition->biped.jump_velocity / (2.f * global_gravity);
+	flight = 2.f * definition->biped.jump_velocity / global_gravity;
+	reach = MAX(0.75f, flight * MAX(COMPANION_RUN_SPEED,
+		magnitude2d((real_vector2d const *)&biped->object.translational_velocity)) + 0.3f);
+	if (reach > 4.f || apex < 0.3f || apex > 2.f)
+		return FALSE;
+	for (sample = 1; sample <= (short)(reach / 0.1f) + 1; sample++)
+	{
+		real_point3d probe;
+		real_point3d support;
+
+		point_from_line3d(&start, &along, MIN(reach, sample * 0.1f), &probe);
+		if (!companion_ground(unit_index, &probe, 0.1f, 0.1f, &support) ||
+			fabs(support.z - start.z) > 0.1f || companion_surface_from(unit_index, &support) == NONE)
+			return FALSE;
+	}
+	for (elevation = 0.27f; elevation <= apex + 0.15f; elevation += 0.1f)
+	{
+		high = start;
+		high.z += elevation;
+		point_from_line3d(&high, &along, reach, &end);
+		if (!companion_clearance(unit_index, &high, &end))
+			return FALSE;
+	}
+	high = start;
+	high.z += 0.03f;
+	end = start;
+	end.z += apex + 0.15f;
+	if (!companion_clearance(unit_index, &high, &end))
+		return FALSE;
+	end = ground;
+	end.z += apex + 0.15f;
+	low = ground;
+	low.z += 0.03f;
+	if (!companion_clearance(unit_index, &end, &low))
+		return FALSE;
+	companion_body.jumping = TRUE;
+	companion_body.jump_airborne = FALSE;
+	companion_body.jump_started = now;
+	companion_body.jump_start = start;
+	companion_body.jump_landing = ground;
+	companion_body.jump_direction = along;
+	companion_body.jump_failed = TRUE;
+	companion_body.act = _companion_act_jump;
+	companion_body.act_time = now;
+	platform_log("Kevin nav: safe jump requested landing=(%.2f %.2f %.2f)", ground.x, ground.y, ground.z);
+	return TRUE;
+}
+
+static boolean companion_progress_stalled(real displacement, real progress, long elapsed, boolean requested)
+{
+	return requested && progress < 0.1f && elapsed >= 2 * TICKS_PER_SECOND &&
+		(displacement < 0.1f || elapsed >= 4 * TICKS_PER_SECOND);
+}
+
+static long companion_retry_ticks(short failures)
+{
+	return failures <= 1 ? TICKS_PER_SECOND : failures == 2 ? 2 * TICKS_PER_SECOND : 5 * TICKS_PER_SECOND;
+}
+
+/* the direction to walk this tick (zero: stand), along his path */
+static void companion_walk_direction(
+	long unit_index,
+	long player_unit_index,
+	struct companion_enemy const *target,
+	real_vector3d *direction)
+{
+	real_point3d origin;
+	real_point3d goal;
+	real_point3d candidate;
+	long now = game_time_get();
+	boolean wanted;
+
+	companion_navigation_metrics();
+	*direction = *global_zero_vector3d;
+	object_get_origin(unit_index, &origin);
+	if (companion_body.jumping)
+	{
+		boolean airborne = TEST_FLAG(biped_get(unit_index)->biped.flags, _biped_airborne_bit);
+
+		if (airborne) companion_body.jump_airborne = TRUE;
+		if ((companion_body.jump_airborne && !airborne) || now - companion_body.jump_started > 3 * TICKS_PER_SECOND ||
+			(!companion_body.jump_airborne && now - companion_body.jump_started > 6))
+		{
+			real_vector3d travelled;
+			real_point3d landing_ground;
+
+			vector_from_points3d(&companion_body.jump_start, &origin, &travelled);
+			companion_body.jumping = FALSE;
+			companion_body.jump_failed = !companion_body.jump_airborne || airborne ||
+				dot_product3d(&travelled, &companion_body.jump_direction) < 0.65f ||
+				!companion_ground(unit_index, &origin, 0.1f, 0.15f, &landing_ground);
+			companion_body.path_valid = FALSE;
+			companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+			platform_log("Kevin nav: %s", companion_body.jump_failed ? "jump failed" : "jump landed");
+		}
+		else
+		{
+			*direction = companion_body.jump_direction;
+			if (companion_flat_distance(&origin, &companion_body.jump_landing) < 0.1f)
+				*direction = *global_zero_vector3d;
+			return;
+		}
+	}
+	if (TEST_FLAG(biped_get(unit_index)->biped.flags, _biped_airborne_bit))
+	{
+		companion_body.progress_time = now;
+		companion_body.requested_move = FALSE;
+		return;
+	}
+	wanted = companion_goal(unit_index, player_unit_index, target, &goal);
+	if (!wanted)
+	{
+		companion_body.requested_move = FALSE;
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+		companion_body.nav_state = _companion_nav_idle;
+		companion_body.progress_time = now;
+		return;
+	}
+	/* Minor movement of Chief must not reset a failed route's budget. */
+	if (!companion_body.goal_valid || distance3d(&goal, &companion_body.desired_goal) > 0.5f)
+	{
+		if (!companion_body.goal_valid || (companion_body.failures &&
+			distance3d(&goal, &companion_body.failure_goal) > 2.f))
+		{
+			companion_body.failures = 0;
+			companion_body.recovery = 0;
+		}
+		companion_body.desired_goal = goal;
+		if (!companion_body.using_alternative) companion_body.goal = goal;
+		companion_body.goal_valid = TRUE;
+		companion_body.goal_dirty = TRUE;
+	}
+	if (companion_body.recovery >= 4)
+	{
+		real_point3d from = origin;
+		real_point3d to = companion_body.goal;
+
+		companion_body.requested_move = FALSE;
+		if (now < companion_body.next_path_time)
+			return;
+		companion_body.next_path_time = now + 5 * TICKS_PER_SECOND;
+		from.z += 0.03f;
+		to.z += 0.03f;
+		/* A reopened obstruction, external relocation, or a new destination
+		can wake safe idle. Do not keep searching the same impossible route. */
+		if (distance3d(&origin, &companion_body.failure_origin) < 0.5f &&
+			(companion_body.nav_state != _companion_nav_blocked || !companion_clearance(unit_index, &from, &to)))
+			return;
+		companion_body.recovery = 0;
+		companion_body.failures = 0;
+		companion_body.next_path_time = now;
+	}
+	if ((!companion_body.path_valid || (companion_body.goal_dirty && !companion_body.using_alternative)) && now >= companion_body.next_path_time)
+	{
+		boolean alternative = companion_body.using_alternative || companion_body.recovery == 2 || companion_body.recovery == 3;
+		real_point3d ground;
+
+		candidate = companion_body.desired_goal;
+		if (companion_body.using_alternative)
+			candidate = companion_body.goal;
+		else if (alternative)
+		{
+			real_vector3d forward;
+			real side = companion_body.recovery == 2 ? 1.f : -1.f;
+			real offset = MAX(0.6f, companion_navigation_radius(unit_index) * 2.f);
+
+			vector_from_points3d(&origin, &candidate, &forward);
+			forward.k = 0.f;
+			normalize3d(&forward);
+			candidate = origin;
+			candidate.x += forward.i * 0.3f - forward.j * side * offset;
+			candidate.y += forward.j * 0.3f + forward.i * side * offset;
+		}
+		else if (companion_body.order == _companion_order_follow && companion_body.failures)
+			object_get_origin(player_unit_index, &candidate);
+		if (companion_ground(unit_index, &candidate, 0.3f, 0.3f, &ground))
+			candidate = ground;
+		companion_body.goal = candidate;
+		companion_body.goal_dirty = FALSE;
+		companion_find_path(unit_index, companion_goal_surface(unit_index, &candidate));
+		companion_body.using_alternative = alternative && companion_body.path_valid;
+		if (!companion_body.path_valid)
+		{
+			if (!companion_body.failures)
+			{
+				companion_body.failure_goal = companion_body.desired_goal;
+				companion_body.failure_origin = origin;
+			}
+			companion_body.failures = MIN(companion_body.failures + 1, 100);
+			companion_body.recovery = MIN(companion_body.recovery + 1, 4);
+			if (companion_body.failures == 4)
+				companion_notice("Kevin exhausted navigation recovery and is waiting for a safe route.");
+			companion_body.next_path_time = now + companion_retry_ticks(companion_body.failures);
+			companion_navigation_note("path rejected; waiting before retry");
+		}
+		if (!companion_body.requested_move)
+		{
+			companion_body.progress_time = now;
+			companion_body.progress_origin = origin;
+			companion_body.progress_distance = REAL_MAX;
+			companion_body.progress_step = NONE;
+		}
+	}
+	if (!companion_body.path_valid)
+	{
+		if (companion_body.nav_state == _companion_nav_blocked && companion_body.recovery >= 2 &&
+			companion_body.recovery < 4)
+		{
+			vector_from_points3d(&origin, &companion_body.desired_goal, direction);
+			direction->k = 0.f;
+			normalize3d(direction);
+			if (companion_safe_direction(unit_index, direction) && companion_try_jump(unit_index, direction))
+				return;
+			*direction = *global_zero_vector3d;
+		}
+		companion_body.requested_move = FALSE;
+		return;
+	}
+	{
+		struct path_result *path = &companion_body.path;
+		real distance;
+
+		while (path->step_index < path->step_count - 1 &&
+			companion_flat_distance(&origin, &path->steps[(short)path->step_index].point) < 0.2f)
+			path->step_index++;
+		distance = distance3d(&origin, &path->steps[(short)path->step_index].point);
+		if (distance < 0.1f)
+		{
+			companion_body.path_valid = FALSE;
+			companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+			if (companion_body.using_alternative && path->steps_finish_path)
+			{
+				companion_body.using_alternative = FALSE;
+				companion_body.failures = 0;
+				companion_body.recovery = 0;
+				companion_body.goal = companion_body.desired_goal;
+			}
+			if (path->steps_finish_path && companion_body.order == _companion_order_follow)
+			{
+				companion_body.goal = goal;
+				companion_body.desired_goal = goal;
+			}
+			companion_body.requested_move = FALSE;
+			return;
+		}
+		if (companion_body.progress_step != path->step_index ||
+			distance3d(&companion_body.progress_waypoint, &path->steps[(short)path->step_index].point) > 0.2f)
+		{
+			/* Replanning or a moving destination must not erase a stall. */
+			companion_body.progress_distance = distance;
+			companion_body.progress_step = path->step_index;
+			companion_body.progress_waypoint = path->steps[(short)path->step_index].point;
+		}
+		if (distance < companion_body.progress_distance - 0.1f &&
+			distance3d(&origin, &companion_body.progress_origin) >= 0.05f)
+		{
+			companion_body.progress_time = now;
+			companion_body.progress_origin = origin;
+			companion_body.progress_distance = distance;
+			companion_body.stalled_since = 0;
+			if (!companion_body.using_alternative)
+			{
+				companion_body.failures = 0;
+				companion_body.recovery = 0;
+			}
+		}
+		if (companion_progress_stalled(distance3d(&origin, &companion_body.progress_origin),
+			companion_body.progress_distance - distance, now - companion_body.progress_time,
+			companion_body.requested_move))
+		{
+			companion_body.path_valid = FALSE;
+			companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+			if (!companion_body.failures)
+			{
+				companion_body.failure_goal = companion_body.desired_goal;
+				companion_body.failure_origin = origin;
+			}
+			companion_body.failures = MIN(companion_body.failures + 1, 100);
+			companion_body.recovery = MIN(companion_body.recovery + 1, 4);
+			if (companion_body.failures == 4)
+				companion_notice("Kevin exhausted navigation recovery and is waiting for a safe route.");
+			companion_body.nav_state = _companion_nav_blocked;
+			companion_body.next_path_time = MAX(companion_body.next_path_time, now + companion_retry_ticks(companion_body.failures));
+			if (!companion_body.stalled_since) companion_body.stalled_since = now;
+			companion_navigation_note("stuck; revalidating route");
+		}
+		vector_from_points3d(&origin, &path->steps[(short)path->step_index].point, direction);
+	}
+	direction->k = 0.f;
+	normalize3d(direction);
+	if (!companion_safe_direction(unit_index, direction))
+	{
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+		companion_body.nav_state = companion_body.safety_obstructed ? _companion_nav_blocked : _companion_nav_invalid_surface;
+		if (!companion_body.failures)
+		{
+			companion_body.failure_goal = companion_body.desired_goal;
+			companion_body.failure_origin = origin;
+		}
+		companion_body.failures = MIN(companion_body.failures + 1, 100);
+		companion_body.recovery = MIN(companion_body.recovery + 1, 4);
+		companion_body.next_path_time = MAX(companion_body.next_path_time, now + companion_retry_ticks(companion_body.failures));
+		if (companion_body.failures == 4)
+			companion_notice("Kevin rejected unsafe terrain repeatedly and is waiting for a safe route.");
+		companion_navigation_note("terrain or obstruction rejected");
+		if (companion_body.safety_obstructed && companion_body.recovery >= 2 &&
+			companion_body.recovery < 4 && companion_try_jump(unit_index, direction))
+			return;
+		*direction = *global_zero_vector3d;
+		companion_body.requested_move = FALSE;
+		return;
+	}
+	if (!companion_body.path_valid)
+	{
+		if (companion_body.recovery >= 2 && companion_body.recovery < 4 && companion_try_jump(unit_index, direction))
+			return;
+		*direction = *global_zero_vector3d;
+		companion_body.requested_move = FALSE;
+		return;
+	}
+	scale_vector3d(direction, companion_body.pace, direction);
+	companion_body.requested_move = TRUE;
+	if (config_boolean("debug.companion"))
+		companion_navigation_note("moving");
+}
+
+
+/* ---------- the body */
+
+static void companion_send_event(char const *text);
+static void companion_text(wchar_t const *text, char *out, int size);
+
+/* at the weapon he walked to, he takes it (the one in his hands dropped when
+both his hands are full, as a player's swap); at the vehicle, he gets in */
+static void companion_reach(
+	long unit_index)
+{
+	struct object_datum *object;
+	real_point3d origin;
+	char text[96];
+
+	if (companion_body.order != _companion_order_pick_up && companion_body.order != _companion_order_get_in)
+		return;
+	object = object_try_and_get_and_verify_type(companion_body.goal_object_index, _object_mask_all);
+	object_get_origin(unit_index, &origin);
+	if (object && companion_body.order == _companion_order_get_in)
+	{
+		short seat_index = NONE;
+		real_point3d entrance;
+
+		/* (at a seat's entrance, as the player gets in; on his way to one
+		while one is free) */
+		if (unit_find_nearby_seat(unit_index, companion_body.goal_object_index, &seat_index) == _unit_nearby_seat_available &&
+			unit_enter_seat(unit_index, companion_body.goal_object_index, seat_index))
+		{
+			snprintf(text, sizeof(text), "Kevin got in the %s.", tag_name_strip_path(tag_get_name(object->definition_index)));
+			companion_send_event(text);
+		}
+		else if (companion_seat_entrance(unit_index, companion_body.goal_object_index, &entrance) &&
+			distance3d(&origin, &entrance) > COMPANION_REACH)
+		{
+			return;
+		}
+		companion_body.order = _companion_order_follow;
+		companion_body.goal_valid = FALSE;
+		return;
+	}
+	if (object && distance3d(&origin, &object->object.bounding_sphere_center) > COMPANION_REACH)
+		return;
+	if (object && companion_body.order == _companion_order_pick_up)
+	{
+		if (unit_inventory_get_weapon(unit_index, 1) != NONE)
+			unit_drop_current_weapon(unit_index, TRUE);
+		if (unit_add_weapon_to_inventory(unit_index, companion_body.goal_object_index, _unit_add_weapon_normal))
+		{
+			snprintf(text, sizeof(text), "Kevin picked up a %s.", tag_name_strip_path(tag_get_name(object->definition_index)));
+			companion_send_event(text);
+		}
+	}
+	companion_body.order = _companion_order_follow;
+	companion_body.goal_valid = FALSE;
+}
+
+static void companion_control(
+	long unit_index,
+	long player_unit_index)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+	struct companion_enemy *target = companion_current_target();
+	struct companion_enemy *act_target = companion_enemy_get(companion_body.act_target_unit_index);
+	long act_ticks = game_time_get() - companion_body.act_time;
+	long held_weapon_index = unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index);
+	short grenade_index = NONE;
+	short weapon_choice = NONE;
+	real turn;
+	struct unit_control_data control;
+	real_vector3d walk;
+	real_vector3d desired;
+	real_vector3d facing;
+	real_vector3d left;
+	unsigned long flags = 0;
+	long weapon_index;
+
+	/* (his own, as any soldier's: a magazine run dry is reloaded, if there's
+	ammo for it) */
+	if (companion_body.act == _companion_act_none && held_weapon_index != NONE)
+	{
+		struct weapon_datum *held = weapon_get(held_weapon_index);
+
+		if (weapon_definition_get(held->definition_index)->weapon.magazines.count > 0 &&
+			held->weapon.magazines[0].rounds_loaded == 0 && held->weapon.magazines[0].rounds_total > 0)
+		{
+			companion_body.act = _companion_act_reload;
+			companion_body.act_target_unit_index = NONE;
+			companion_body.act_time = game_time_get();
+			act_ticks = 0;
+		}
+	}
+
+	if (unit->object.parent_object_index != NONE)
+		walk = *global_zero_vector3d;
+	else
+		companion_walk_direction(unit_index, player_unit_index, target, &walk);
+	/* Legacy pickups/vehicles remain implemented, outside the active order path. */
+
+	act_ticks = game_time_get() - companion_body.act_time;
+
+	/* Smooth aim toward the native target; the weapon supplies its own spread. */
+	if (target && target->visible)
+	{
+		real_point3d eye;
+
+		unit_get_camera_position(unit_index, &eye);
+		vector_from_points3d(&eye, &target->aim_point, &desired);
+		normalize3d(&desired);
+	}
+	else if (mate_link_voice_playing() && companion_unit_alive(player_unit_index))
+	{
+		/* (talking: he looks at the Chief) */
+		real_point3d eye;
+		real_point3d head;
+
+		unit_get_camera_position(unit_index, &eye);
+		unit_get_camera_position(player_unit_index, &head);
+		vector_from_points3d(&eye, &head, &desired);
+		if (magnitude3d(&desired) < 0.01f)
+			desired = companion_body.aim;
+		normalize3d(&desired);
+	}
+	else if (magnitude3d(&walk) > 0.f)
+	{
+		desired = walk;
+		normalize3d(&desired);
+	}
+	else
+	{
+		/* (standing about: he looks around, and at the Chief now and then) */
+		if (game_time_get() >= companion_body.look_until)
+		{
+			real yaw = (real)atan2(companion_body.aim.j, companion_body.aim.i) + companion_random() * 1.2f;
+			real pitch = companion_random() * 0.15f;
+
+			companion_body.look_at_player = companion_random01() < 0.35f;
+			companion_body.look.i = (real)(cos(yaw) * cos(pitch));
+			companion_body.look.j = (real)(sin(yaw) * cos(pitch));
+			companion_body.look.k = (real)sin(pitch);
+			companion_body.look_until = game_time_get() + (long)((2.f + 4.f * companion_random01()) * TICKS_PER_SECOND);
+		}
+		desired = companion_body.look;
+		if (companion_body.look_at_player && companion_unit_alive(player_unit_index))
+		{
+			real_point3d eye;
+			real_point3d head;
+
+			unit_get_camera_position(unit_index, &eye);
+			unit_get_camera_position(player_unit_index, &head);
+			vector_from_points3d(&eye, &head, &desired);
+			if (magnitude3d(&desired) < 0.01f)
+				desired = companion_body.aim;
+			normalize3d(&desired);
+		}
+	}
+	turn = target && target->visible ? COMPANION_AIM_TURN : COMPANION_LOOK_TURN;
+	companion_body.aim.i += (desired.i - companion_body.aim.i) * turn;
+	companion_body.aim.j += (desired.j - companion_body.aim.j) * turn;
+	companion_body.aim.k += (desired.k - companion_body.aim.k) * turn;
+	if (magnitude3d(&companion_body.aim) < 0.01f)
+		companion_body.aim = unit->object.forward;
+	normalize3d(&companion_body.aim);
+
+	/* (he faces where he aims, level; he walks in that frame) */
+	facing = companion_body.aim;
+	facing.k = 0.f;
+	if (magnitude3d(&facing) < 0.01f)
+		facing = unit->object.forward;
+	normalize3d(&facing);
+	cross_product3d(global_up3d, &facing, &left);
+
+	/* the one-off action mate chose: a press, or a grenade's throw held */
+	switch (companion_body.act)
+	{
+	case _companion_act_reload: SET_FLAG(flags, _unit_control_weapon_reload_bit, act_ticks == 0); break;
+	case _companion_act_melee: SET_FLAG(flags, _unit_control_use_equipment_bit, act_ticks == 0); break;
+	case _companion_act_jump: SET_FLAG(flags, _unit_control_jump_bit, game_time_get() == companion_body.jump_started); break;
+	case _companion_act_light: SET_FLAG(flags, _unit_control_integrated_light_bit, act_ticks == 0); break;
+	case _companion_act_get_out: SET_FLAG(flags, _unit_control_action_bit, act_ticks == 0); break;
+	case _companion_act_swap:
+		/* (the other weapon, as the one he wants: unit_control's weapon index) */
+		if (act_ticks == 0 && unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index ? 0 : 1) != NONE)
+			weapon_choice = unit->unit.current_weapon_index ? 0 : 1;
+		break;
+	case _companion_act_grenade:
+		if (unit->unit.grenade_counts[companion_body.act_grenade_type])
+			grenade_index = companion_body.act_grenade_type;
+		SET_FLAG(flags, _unit_control_throw_grenade_bit, grenade_index != NONE && act_ticks < COMPANION_GRENADE_TICKS);
+		break;
+	}
+	if (act_ticks >= COMPANION_GRENADE_TICKS)
+		companion_body.act = _companion_act_none;
+
+	/* Fire only at a currently visible, in-range, safe native target. */
+	weapon_index = unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index);
+	if (weapon_index != NONE && companion_body.act == _companion_act_none)
+	{
+		if (target && target->visible &&
+			game_time_get() - companion_body.target_time >= COMPANION_REACTION_TICKS &&
+			dot_product3d(&companion_body.aim, &desired) > 0.999f &&
+			!companion_body.hold_fire && target->distance <= companion_engagement_range(unit_index) &&
+			companion_safe_shot(unit_index, target, TRUE))
+		{
+			struct weapon_definition *definition = weapon_definition_get(weapon_get(weapon_index)->definition_index);
+			boolean latched = FALSE;
+			real rate = 5.f;
+
+			if (definition->weapon.triggers.count > 0)
+			{
+				struct weapon_trigger_definition *trigger = TAG_BLOCK_GET_ELEMENT(&definition->weapon.triggers, 0,
+					struct weapon_trigger_definition);
+				latched = TEST_FLAG(trigger->flags, _weapon_trigger_latched_bit);
+				rate = trigger->initial_rate_of_fire;
+			}
+			SET_FLAG(flags, _unit_control_weapon_primary_trigger_bit,
+				companion_trigger_on(game_time_get() - companion_body.burst_time, latched, rate));
+		}
+		else
+		{
+			companion_body.burst_time = game_time_get();
+		}
+	}
+
+	/* crouching as mate said, and in cover once there */
+	companion_body.crouch = companion_body.crouching ||
+		(companion_body.order == _companion_order_cover && magnitude3d(&walk) == 0.f && target != NULL);
+	SET_FLAG(flags, _unit_control_crouch_modifier_bit, companion_body.crouch);
+
+	csmemset(&control, 0, sizeof(control));
+	/* (as a player's unit always is: "alert" walks at walking speed, and can't strafe) */
+	control.animation_state = _unit_animation_state_in_combat;
+	control.aiming_speed = _unit_aiming_speed_alert;
+	control.control_flags = (word)flags;
+	control.weapon_index = weapon_choice;
+	control.grenade_index = grenade_index;
+	control.zoom_level = NONE;
+	control.throttle.i = dot_product3d(&walk, &facing);
+	control.throttle.j = dot_product3d(&walk, &left);
+	control.throttle.k = 0.f;
+	control.primary_trigger = TEST_FLAG(flags, _unit_control_weapon_primary_trigger_bit) ? 1.f : 0.f;
+	control.facing_vector = facing;
+	control.aiming_vector = companion_body.aim;
+	control.looking_vector = companion_body.aim;
+	unit_control(unit_index, &control);
+}
