+/* ---------- mate */
+
+static void companion_set_order(
+	short order,
+	long target_unit_index,
+	boolean hold_fire)
+{
+	boolean changed = order != companion_body.order || hold_fire != companion_body.hold_fire;
+
+	if (order != companion_body.order)
+	{
+		if (order == _companion_order_hold && companion_unit_index != NONE)
+			object_get_origin(companion_unit_index, &companion_body.hold_point);
+		companion_body.goal_valid = FALSE;
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+		companion_body.jumping = FALSE;
+		companion_body.using_alternative = FALSE;
+		companion_body.requested_move = FALSE;
+		companion_body.failures = 0;
+		companion_body.recovery = 0;
+		companion_body.progress_time = game_time_get();
+		companion_body.next_path_time = MAX(companion_body.next_path_time, game_time_get());
+	}
+	companion_body.order = order;
+	if (hold_fire != companion_body.hold_fire)
+	{
+		companion_body.target_unit_index = NONE;
+		companion_body.target_lost_time = 0;
+		platform_log("Kevin combat: hold fire %s", hold_fire ? "enabled" : "disabled");
+	}
+	companion_body.hold_fire = hold_fire;
+	if (changed)
+		platform_log("Kevin order: %s, fire %s", companion_order_names[order], hold_fire ? "disabled" : "enabled");
+}
