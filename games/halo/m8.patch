@@ -0,0 +1,51 @@
+"""Native targeting, fire safety, command parsing and persistent orders."""
+import sys
+import re
+from pathlib import Path
+import pytest
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from harness import build, read, function, structure, enum_with, mutated, run, CHECK_FAILED
+FUNCTIONS = ['companion_enemy_team','companion_unit_alive','companion_enemy_get','companion_current_target',
+             'companion_weapon_range','companion_engagement_range','companion_friendly_cone',
+             'companion_safe_shot','companion_target_eligible','companion_update_target','companion_in_combat','companion_trigger_on',
+             'companion_set_order','companion_message_value','companion_message_number',
+             'companion_context_current','companion_capture_context','companion_apply_command','companion_reset_body']
+CASES = ['combat-state','profiles','acquire','occluded-elite','retain','switch','visibility-grace','friendly-fire',
+         'trigger','captured-aim','orders','reject-location','context','parser','reset']
+
+
+def generated(fault=None):
+    source=read('port/linux/game/companion.c')
+    config=enum_with(source,'_companion_order_follow')+enum_with(source,'_companion_nav_idle')
+    for name in ['companion_corridor','companion_nav_metrics','companion_enemy','companion_body','companion_command_context']:
+        config+=structure(source,name)
+    # The standard harness extractor counts braces in character literals.
+    # Mask literals/comments for locating boundaries, then compile the original.
+    masked=re.sub(r""""(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|/\*.*?\*/|//[^\n]*""",
+                  lambda m: re.sub(r'[^\n]', ' ', m[0]), source, flags=re.S)
+    pieces=[]
+    for name in FUNCTIONS:
+        body=function(masked,name)
+        start=masked.index(body)
+        pieces.append(source[start:start+len(body)])
+    code='\n'.join(pieces)
+    if fault=='visibility':
+        code=mutated(code,'return enemy && enemy->visible && enemy->distance <= range &&',
+                     'return enemy && enemy->distance <= range &&')
+        code=mutated(code,'!enemy || !enemy->visible || !companion_unit_alive(enemy->unit_index)',
+                     '!enemy || !companion_unit_alive(enemy->unit_index)')
+    if fault=='friendly':
+        code=mutated(code,'return squared < radius * radius;', 'return squared < -1.f;')
+    return (('config.inc',config),('under_test.inc',code))
+
+
+@pytest.mark.parametrize('case',CASES)
+def test_case(case):
+    status,output=run(build('companion_combat',generated()),case)
+    assert status==0,output
+
+
+@pytest.mark.parametrize('fault,case',[('visibility','occluded-elite'),('friendly','friendly-fire')])
+def test_negative_control(fault,case):
+    status,output=run(build('companion_combat',generated(fault)),case)
+    assert status==CHECK_FAILED,output
