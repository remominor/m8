+static void companion_catch_up(
+	long unit_index,
+	long player_unit_index)
+{
+	real_point3d origin;
+	real_point3d player_origin;
+	real_point3d ground;
+	long now = game_time_get();
+
+	if (companion_body.order != _companion_order_follow ||
+		unit_get(unit_index)->object.parent_object_index != NONE)
+		return;
+	object_get_origin(unit_index, &origin);
+	object_get_origin(player_unit_index, &player_origin);
+	if (distance3d(&origin, &player_origin) <= COMPANION_TELEPORT_DISTANCE)
+	{
+		companion_body.far_since = 0;
+		return;
+	}
+	if (!companion_body.far_since)
+		companion_body.far_since = now;
+	if (now - companion_body.far_since < 10 * TICKS_PER_SECOND ||
+		now < companion_body.teleport_time || (companion_body.failures < 3 &&
+		(!companion_body.stalled_since || now - companion_body.stalled_since < 6 * TICKS_PER_SECOND)))
+		return;
+	if (coop_enemies_spread_position(&player_origin, 1, NULL, &origin) &&
+		companion_ground(unit_index, &origin, 0.1f, 0.2f, &ground))
+	{
+		object_set_position(unit_index, &ground, NULL, NULL);
+		unit_get(unit_index)->object.translational_velocity = *global_zero_vector3d;
+		companion_body.requested_move = FALSE;
+		companion_body.stalled_since = 0;
+		companion_body.next_path_time = MAX(now, companion_body.path_time + COMPANION_PATH_TICKS);
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+		companion_body.goal_valid = FALSE;
+		companion_body.teleport_time = now + 30 * TICKS_PER_SECOND;
+		companion_navigation_note("last resort catch-up");
+		companion_notice("Kevin used last-resort long-distance catch-up after navigation failed.");
+	}
+}
