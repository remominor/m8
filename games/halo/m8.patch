+
+/* The link emits flat JSON objects. Read complete members, rejecting escaped
+strings, duplicate keys, overlong values and trailing junk in numeric fields. */
+static boolean companion_message_value(char const *message, char const *key, char *out, int size)
+{
+	char member[64];
+	char const *at;
+	char const *end;
+	int length;
+
+	snprintf(member, sizeof(member), "\"%s\"", key);
+	at = strstr(message, member);
+	if (!at || strstr(at + strlen(member), member)) return FALSE;
+	at += strlen(member);
+	while (*at == ' ' || *at == '\t') at++;
+	if (*at++ != ':') return FALSE;
+	while (*at == ' ' || *at == '\t') at++;
+	if (*at == '"')
+	{
+		at++;
+		end = at;
+		while (*end && *end != '"' && *end != '\\') end++;
+		if (*end != '"') return FALSE;
+		{
+			char const *after = end + 1;
+			while (*after == ' ' || *after == '\t') after++;
+			if (*after != ',' && *after != '}') return FALSE;
+		}
+	}
+	else
+	{
+		end = at;
+		while (*end >= '0' && *end <= '9') end++;
+		if (end == at || (*end != ',' && *end != '}' && *end != ' ')) return FALSE;
+	}
+	length = (int)(end - at);
+	if (length <= 0 || length >= size) return FALSE;
+	memcpy(out, at, length);
+	out[length] = 0;
+	return TRUE;
+}
+
+static long companion_message_number(char const *message, char const *key)
+{
+	char value[16];
+	char *end;
+	unsigned long result;
+
+	if (!companion_message_value(message, key, value, sizeof(value)) || value[0] < '0' || value[0] > '9')
+		return 0;
+	result = strtoul(value, &end, 10);
+	return *end || result > 0x7fffffffUL ? 0 : (long)result;
+}
+
+static struct companion_command_context *companion_capture_context(void)
+{
+	struct companion_command_context *context;
+	long player = companion_player_unit();
+	real_point3d eye;
+	real_vector3d along;
+	struct collision_result collision;
+
+	companion_context_serial = companion_context_serial >= 0x7ffffffeL ? 1 : companion_context_serial + 1;
+	context = &companion_contexts[companion_context_serial % 32];
+	csmemset(context, 0, sizeof(*context));
+	context->id = companion_context_serial;
+	context->lifecycle = companion_lifecycle;
+	context->connection = companion_connection;
+	context->time = game_time_get();
+	if (!companion_unit_alive(player) || !companion_unit_alive(companion_unit_index) || cinematic_in_progress())
+		return context;
+	unit_get_camera_position(player, &eye);
+	unit_get_aiming_vector(player, &along);
+	normalize3d(&along);
+	scale_vector3d(&along, COMPANION_VIEW_REACH, &along);
+	if (collision_test_vector(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit) |
+		FLAG(_collision_test_objects_bit) | _collision_test_objects_all_types_flags,
+		&eye, &along, player, &collision) && collision.type == _collision_result_structure && collision.plane.n.k >= 0.6f)
+	{
+		context->ground = collision.point;
+		context->valid = TRUE;
+	}
+	return context;
+}
+
+static boolean companion_context_current(struct companion_command_context const *context, long id)
+{
+	long elapsed = game_time_get() - context->time;
+
+	return id > 0 && context->id == id && context->lifecycle == companion_lifecycle &&
+		context->connection == companion_connection && elapsed >= 0 && elapsed <= 30 * TICKS_PER_SECOND;
+}
+
+static char const *companion_apply_command(char const *action, struct companion_command_context const *context)
+{
+	short order = companion_body.order;
+	boolean hold_fire = companion_body.hold_fire;
+	real_point3d ground;
+
+	if (!strcmp(action, "none")) return NULL;
+	if (!strcmp(action, "follow")) order = _companion_order_follow;
+	else if (!strcmp(action, "stay")) order = _companion_order_hold;
+	else if (!strcmp(action, "hold_fire")) hold_fire = TRUE;
+	else if (!strcmp(action, "resume_fire")) hold_fire = FALSE;
+	else if (!strcmp(action, "go_aim"))
+	{
+		if (!context->valid) return "No valid ground was aimed at when you spoke.";
+		if (!companion_ground(companion_unit_index, &context->ground, 0.1f, 0.15f, &ground))
+			return "That location has unsafe or unsupported terrain.";
+		ground.z += 0.03f;
+		if (!companion_clearance(companion_unit_index, &ground, &ground) ||
+			!companion_reachable(companion_unit_index, &context->ground))
+			return "I cannot find a safe reachable route to that location.";
+		order = _companion_order_move;
+	}
+	else return "Unsupported command; orders unchanged.";
+	companion_set_order(order, NONE, hold_fire);
+	if (!strcmp(action, "stay"))
+	{
+		object_get_origin(companion_unit_index, &companion_body.hold_point);
+		companion_body.goal_valid = FALSE;
+		companion_body.jumping = FALSE;
+		companion_body.using_alternative = FALSE;
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+	}
+	if (!strcmp(action, "go_aim"))
+	{
+		companion_body.hold_point = context->ground;
+		companion_body.jumping = FALSE;
+		companion_body.using_alternative = FALSE;
+		companion_body.requested_move = FALSE;
+		companion_body.goal_valid = FALSE;
+		companion_body.path_valid = FALSE;
+		companion_body.safety[0].valid = companion_body.safety[1].valid = FALSE;
+		companion_body.failures = 0;
+		companion_body.recovery = 0;
+	}
+	return NULL;
+}
+
+static void companion_handle_messages(void)
+{
+	char message[2048];
+	char type[32];
+	char action[32];
+	char json[768];
+
+	while (mate_link_next_message(message, sizeof(message)))
+	{
+		long request = companion_message_number(message, "request_id");
+
+		if (!companion_message_value(message, "type", type, sizeof(type))) continue;
+		if (!strcmp(type, "hello"))
+		{
+			companion_connection++;
+			continue;
+		}
+		if (!strcmp(type, "view"))
+		{
+			companion_view_requested = TRUE;
+			continue;
+		}
+		if (!strcmp(type, "capture_command"))
+		{
+			struct companion_command_context *context = companion_capture_context();
+
+			snprintf(json, sizeof(json), "{\"type\":\"command_context\",\"request_id\":%ld,\"context_id\":%ld,\"aim_valid\":%s}",
+				request, context->id, context->valid ? "true" : "false");
+			mate_link_send(json);
+		}
+		else if (!strcmp(type, "action"))
+		{
+			long id = companion_message_number(message, "context_id");
+			struct companion_command_context *context = &companion_contexts[id % 32];
+			char const *error;
+
+			if (!companion_message_value(message, "action", action, sizeof(action)))
+				strcpy(action, "invalid");
+			if (!companion_unit_alive(companion_unit_index) || !companion_unit_alive(companion_player_unit()) ||
+				cinematic_in_progress() || game_engine_running() || network_game_distributed_client())
+				error = "Kevin cannot accept orders in the current game state.";
+			else if (!companion_context_current(context, id))
+				error = "The game changed or the order waited too long; please repeat it.";
+			else
+			{
+				error = companion_apply_command(action, context);
+				context->id = 0;
+			}
+			snprintf(json, sizeof(json), "{\"type\":\"command_result\",\"request_id\":%ld,\"accepted\":%s,"
+				"\"movement_order\":\"%s\",\"fire_enabled\":%s,\"text\":\"%s\"}", request,
+				error ? "false" : "true", companion_order_names[companion_body.order],
+				companion_body.hold_fire ? "false" : "true", error ? error : "Order accepted.");
+			mate_link_send(json);
+			platform_log("Kevin command: %s %s", action, error ? error : "accepted");
+		}
+	}
+}
+
+
+/* where something is from him, in words ("ahead", "to the left", ...) */
+static char const *companion_direction_name(
+	long unit_index,
+	real_point3d const *point)
+{
+	real_vector3d to;
+	real_vector3d left;
+	real forward_amount;
+	real left_amount;
+
+	vector_from_points3d(&unit_get(unit_index)->object.position, point, &to);
+	to.k = 0.f;
+	normalize3d(&to);
+	cross_product3d(global_up3d, &companion_body.aim, &left);
+	forward_amount = to.i * companion_body.aim.i + to.j * companion_body.aim.j;
+	left_amount = dot_product3d(&to, &left);
+	if (forward_amount > 0.7f)
+		return "ahead";
+	if (forward_amount < -0.7f)
+		return "behind";
+	return left_amount > 0.f ? "to the left" : "to the right";
+}
+
+/* (the decision model reads words far better than numbers) */
+static char const *companion_health_words(
+	real vitality)
+{
+	return vitality >= 0.95f ? "unhurt" : vitality >= 0.6f ? "a bit hurt" : vitality >= 0.3f ? "hurt" : "badly hurt";
+}
+
+static char const *companion_shield_words(
+	real vitality)
+{
+	return vitality >= 0.95f ? "shields full" : vitality >= 0.5f ? "shields holding" : vitality > 0.f ? "shields low" : "shields down";
+}
+
+/* (a unit's, a weapon's or a vehicle's: its tag's name) */
+static char const *companion_unit_kind(
+	long object_index)
+{
+	return tag_name_strip_path(tag_get_name(object_get(object_index)->definition_index));
+}
+
+/* an enemy in words: "elite close (9 m) ahead, in sight, unhurt, shields full" */
+static void companion_describe_enemy(
+	struct companion_enemy const *enemy,
+	char *buffer,
+	int size)
+{
+	struct unit_datum *unit = unit_get(enemy->unit_index);
+	int metres = (int)(enemy->distance * COMPANION_METRES_PER_UNIT);
+
+	char aboard[64] = "";
+
+	if (unit->object.parent_object_index != NONE)
+	{
+		char const *vehicle = companion_unit_kind(unit->object.parent_object_index);
+
+		snprintf(aboard, sizeof(aboard), " aboard a%s %s", strchr("aeiou", vehicle[0]) ? "n" : "", vehicle);
+	}
+	snprintf(buffer, size, "%s%s %s (%d m) %s, %s, %s%s%s",
+		companion_unit_kind(enemy->unit_index),
+		aboard,
+		metres <= 10 ? "close" : metres <= 25 ? "at mid range" : "far away",
+		metres,
+		companion_direction_name(companion_unit_index, &enemy->aim_point),
+		enemy->visible ? "in sight" : "out of sight",
+		companion_health_words(unit->object.body_vitality),
+		unit->object.shield_vitality > 0.f ? ", " : "",
+		unit->object.shield_vitality > 0.f ? companion_shield_words(unit->object.shield_vitality) : "");
+}
+
+/* enemies of a kind, counted: aboard a vehicle, or on foot in a direction */
+struct companion_group
+{
+	long vehicle_index;
+	char const *kind;
+	char const *direction;
+	short count;
+};
+
+/* one more enemy in the groups: of its kind aboard its vehicle (NONE: on foot, in its
+direction) */
+static void companion_group_add(
+	struct companion_group *groups,
+	short *count,
+	short maximum,
+	long vehicle_index,
+	char const *kind,
+	char const *direction)
+{
+	short index;
+
+	for (index = 0; index < *count; index++)
+	{
+		struct companion_group *group = &groups[index];
+
+		if (group->vehicle_index == vehicle_index && !strcmp(group->kind, kind) &&
+			(vehicle_index != NONE || !strcmp(group->direction, direction)))
+		{
+			group->count++;
+			return;
+		}
+	}
+	if (*count < maximum)
+	{
+		groups[*count].vehicle_index = vehicle_index;
+		groups[*count].kind = kind;
+		groups[*count].direction = direction;
+		groups[*count].count = 1;
+		(*count)++;
+	}
+}
+
+/* a vehicle's groups in words: "4 grunts and an elite" */
+static void companion_riders_words(
+	struct companion_group const *groups,
+	short count,
+	long vehicle_index,
+	char *buffer,
+	int size)
+{
+	short index;
+
+	buffer[0] = 0;
+	for (index = 0; index < count; index++)
+	{
+		struct companion_group const *group = &groups[index];
+		char one[64];
+
+		if (group->vehicle_index != vehicle_index)
+			continue;
+		if (group->count == 1)
+			snprintf(one, sizeof(one), "%sa%s %s", buffer[0] ? " and " : "", strchr("aeiou", group->kind[0]) ? "n" : "", group->kind);
+		else
+			snprintf(one, sizeof(one), "%s%d %ss", buffer[0] ? " and " : "", group->count, group->kind);
+		strncat(buffer, one, size - strlen(buffer) - 1);
+	}
+}
+
+/* the groups in words: "a dropship ahead, carrying 4 grunts and an elite; 2 jackals to the left" */
+static void companion_groups_words(
+	struct companion_group const *groups,
+	short count,
+	char *buffer,
+	int size)
+{
+	short index;
+
+	buffer[0] = 0;
+	for (index = 0; index < count; index++)
+	{
+		struct companion_group const *group = &groups[index];
+		char one[256];
+
+		if (group->vehicle_index != NONE)
+		{
+			char const *vehicle = companion_unit_kind(group->vehicle_index);
+			char riders[192];
+			short earlier;
+
+			/* (a vehicle once, at its first group) */
+			for (earlier = 0; earlier < index && groups[earlier].vehicle_index != group->vehicle_index; earlier++)
+				;
+			if (earlier < index)
+				continue;
+			companion_riders_words(groups, count, group->vehicle_index, riders, sizeof(riders));
+			snprintf(one, sizeof(one), "%sa%s %s %s, carrying %s", buffer[0] ? "; " : "",
+				strchr("aeiou", vehicle[0]) ? "n" : "", vehicle,
+				companion_direction_name(companion_unit_index, &object_get(group->vehicle_index)->object.bounding_sphere_center),
+				riders);
+		}
+		else if (group->count == 1)
+		{
+			snprintf(one, sizeof(one), "%sa%s %s %s", buffer[0] ? "; " : "",
+				strchr("aeiou", group->kind[0]) ? "n" : "", group->kind, group->direction);
+		}
+		else
+		{
+			snprintf(one, sizeof(one), "%s%d %ss %s", buffer[0] ? "; " : "", group->count, group->kind, group->direction);
+		}
+		strncat(buffer, one, size - strlen(buffer) - 1);
+	}
+}
+
+/* what Kevin is doing, in words, each part after a comma (", following
+{player}, shooting at the grunt"); staying where he is, nothing of it */
+static void companion_describe_doing(
+	char *buffer,
+	int size)
+{
+	struct companion_enemy const *target = companion_current_target();
+
+	switch (companion_body.order)
+	{
+	case _companion_order_follow: snprintf(buffer, size, ", following {player}"); break;
+	case _companion_order_move: snprintf(buffer, size, ", keeping the ordered destination"); break;
+	default: snprintf(buffer, size, ", holding position"); break;
+	}
+	if (companion_body.hold_fire)
+		strncat(buffer, ", holding fire", size - strlen(buffer) - 1);
+	else if (target)
+	{
+		strncat(buffer, target->visible ? ", engaging the " : ", tracking the out-of-sight ", size - strlen(buffer) - 1);
+		strncat(buffer, companion_unit_kind(target->unit_index), size - strlen(buffer) - 1);
+	}
+	else
+		strncat(buffer, ", autonomous fire enabled", size - strlen(buffer) - 1);
+}
+
+/* an action for mate's list: its name, its description, and its targets
+(NULL: it has none; empty: there is nothing to do it to, so it isn't offered) */
+static void companion_add_action(
+	char *actions,
+	int size,
+	char const *name,
+	char const *description,
+	char const *targets)
+{
+	char one[1536];
+
+	if (targets && !targets[0])
+		return;
+	snprintf(one, sizeof(one), "%s{\"name\":\"%s\",\"description\":\"%s\"%s%s%s}", actions[0] ? "," : "",
+		name, description, targets ? ",\"options\":{" : "", targets ? targets : "", targets ? "}" : "");
+	if ((int)(strlen(actions) + strlen(one)) < size)
+		strcat(actions, one);
+}
+
+/* the things in a list, what a search finds ("shotgun (4 m) ahead; ...", or
+"none nearby"), and as options for mate */
+static void companion_describe_things(
+	struct companion_thing const *things,
+	short count,
+	char *list,
+	int list_size,
+	char *options,
+	int options_size)
+{
+	char one[160];
+	char option[200];
+	short index;
+
+	snprintf(list, list_size, "%s", count ? "" : "none nearby");
+	for (index = 0; index < count; index++)
+	{
+		int metres = (int)(things[index].distance * COMPANION_METRES_PER_UNIT);
+
+		snprintf(one, sizeof(one), "%s (%d m) %s",
+			tag_name_strip_path(tag_get_name(object_get(things[index].object_index)->definition_index)),
+			metres, companion_direction_name(companion_unit_index, &object_get(things[index].object_index)->object.bounding_sphere_center));
+		if (index)
+			strncat(list, "; ", list_size - strlen(list) - 1);
+		strncat(list, one, list_size - strlen(list) - 1);
+		snprintf(option, sizeof(option), "%s\"%ld\":\"%s\"", index ? "," : "", things[index].object_index & 0xFFFF, one);
+		if ((int)(strlen(options) + strlen(option)) < options_size)
+			strcat(options, option);
+	}
+}
