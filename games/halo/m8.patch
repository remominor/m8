index 0000000000000000000000000000000000000000..973e0a21f87954334eecf4018b8d673622e74838
--- /dev/null
+++ b/tools/harness/tests/test_companion.py
@@ -0,0 +1,72 @@
+"""Real native companion movement against deterministic path/collision results."""
+import sys
+from pathlib import Path
+import pytest
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from harness import build, read, function, structure, enum_with, mutated, run, CHECK_FAILED
+
+FUNCTIONS = ['companion_navigation_radius', 'companion_flat_distance', 'companion_ground_probe', 'companion_ground', 'companion_clearance',
+             'companion_step_clearance', 'companion_safety_invalidate', 'companion_navigation_metrics', 'companion_corridor_contains',
+             'companion_validate_corridor', 'companion_safe_direction_check', 'companion_safe_direction', 'companion_try_jump', 'companion_progress_stalled',
+             'companion_retry_ticks', 'companion_follow_goal', 'companion_goal',
+             'companion_find_path', 'companion_walk_direction', 'companion_catch_up']
+CASES = ['follow', 'running-follow', 'moving-chief-stuck', 'orders', 'failed-path', 'retry-budget', 'alternative', 'partial-path', 'progress',
+         'cliff', 'slope', 'clearance', 'jump', 'jump-outcome', 'unsafe-jump', 'teleport', 'safety-performance', 'cache-expiry', 'cache-boundary', 'cache-turn',
+         'cache-invalidation', 'cache-speed', 'cache-obstruction', 'cliff-speeds', 'cache-slope', 'cache-jump', 'cache-actual-position', 'floor-contact']
+
+
+def generated(fault=None):
+    source = read('port/linux/game/companion.c')
+    config = enum_with(source, '_companion_order_follow') + enum_with(source, '_companion_nav_idle')
+    config += structure(source, 'companion_corridor') + structure(source, 'companion_nav_metrics')
+    config += structure(source, 'companion_enemy') + structure(source, 'companion_body')
+    code = '\n'.join(function(source, name) for name in FUNCTIONS).replace('\t', ' ')
+    if fault == 'cliff':
+        code = mutated(code, 'if (!cached && !companion_validate_corridor',
+                       'if (!cached && FALSE && !companion_validate_corridor')
+    if fault == 'cache-boundary':
+        code = mutated(code, 'end_projection > cache->reach - 0.02f', 'FALSE')
+    if fault == 'floor-contact':
+        code = mutated(code, 'if (!companion_step_clearance(unit_index, &start, &ground))',
+                       'if (!companion_clearance(unit_index, &start, &ground))')
+    if fault == 'retry':
+        code = mutated(code, 'now >= companion_body.next_path_time', '1')
+    if fault == 'pending':
+        code = mutated(code, 'companion_body.goal_dirty = TRUE;', 'companion_body.goal_dirty = TRUE;\n companion_body.path_valid = FALSE;')
+    if fault == 'failure':
+        code = mutated(code, '*direction = *global_zero_vector3d;\n  }\n  companion_body.requested_move = FALSE;',
+                       '*direction = *global_zero_vector3d;\n  }\n  direction->i = 1.f;\n  companion_body.requested_move = FALSE;')
+    return (('config.inc', config), ('under_test.inc', code))
+
+
+@pytest.mark.parametrize('case', CASES)
+def test_case(case):
+    status, output = run(build('companion', generated()), case)
+    assert status == 0, output
+
+
+@pytest.mark.parametrize('fault,case', [('retry','retry-budget'), ('failure','failed-path'), ('pending','running-follow'), ('cache-boundary','cache-boundary'), ('cliff','cliff'), ('floor-contact','floor-contact')])
+def test_negative_control(fault, case):
+    status, output = run(build('companion', generated(fault)), case)
+    assert status == CHECK_FAILED, output
+
+
+if __name__ == '__main__':
+    # Compare the same fake-world motion with an archived companion.c, e.g. a
+    # clean checkout with the Sprint 1 portable patch applied.
+    import argparse
+    parser = argparse.ArgumentParser(description='Compare 90 ticks of safety query counts')
+    parser.add_argument('--baseline-source', type=Path, required=True)
+    args = parser.parse_args()
+    source = args.baseline_source.read_text()
+    config = '#define BASELINE_COMPANION 1\n' + enum_with(source, '_companion_order_follow') + enum_with(source, '_companion_nav_idle')
+    config += structure(source, 'companion_enemy') + structure(source, 'companion_body')
+    original_functions = ['companion_navigation_radius', 'companion_flat_distance', 'companion_ground', 'companion_clearance',
+                          'companion_safe_direction', 'companion_try_jump', 'companion_progress_stalled', 'companion_retry_ticks',
+                          'companion_follow_goal', 'companion_goal', 'companion_find_path', 'companion_walk_direction', 'companion_catch_up']
+    code = '\n'.join(function(source, name) for name in original_functions)
+    for name, inputs in [('baseline', (('config.inc', config), ('under_test.inc', code))), ('current', generated())]:
+        status, output = run(build('companion', inputs), 'safety-performance')
+        if status:
+            raise SystemExit(output)
+        print(f'{name}: {output}')
